{
  "name": "crowd-wx-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "types": "./dist/lib/types/lib/main.d.ts",
  "scripts": {
    "dev": "vite",
    "buildxxx": "tsc -b && vite build",
    "build": "tsc --p ./tsconfig.module.build.json && vite build",
    "build:lib": "tsc --p ./tsconfig.module.build.json && vite build --config vite.config.lib.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "types": "tsc --emitDeclarationOnly"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/types/lib/main.d.ts",
      "import": "./dist/lib/crowd-wx-editor.js",
      "require": "./dist/lib/crowd-wx-editor.cjs"
    },
    "./types": {
      "import": "./dist/lib/types/lib/main.d.ts",
      "require": "./dist/lib/types/lib/main.d.ts"
    },
    "./styles": "./dist/lib/styles.css"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "react-dropzone": "^14.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.14.0",
    "@types/react": "^16.9.0",
    "@types/react-dom": "^16.9.25",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
